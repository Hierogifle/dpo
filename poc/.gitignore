@'
# Données privées et identifiantes
/data/private/

# Catalogue Kaggle brut
/data/raw/*
!/data/raw/.gitkeep

# Secrets et configuration locale
.env
.env.*
*.key
*.secret

# Environnements Python
.venv/
venv/
env/

# Caches Python et tests
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Fichiers temporaires
*.tmp
*.bak
.DS_Store
Thumbs.db
'@ | Set-Content -Path .gitignore -Encoding utf8